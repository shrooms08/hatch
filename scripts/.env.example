# Scripts env (copy to scripts/.env; never commit the real file). No secrets here.

# Devnet scripts (default network). Must not point at mainnet: the scripts refuse to run.
RPC_URL=https://api.devnet.solana.com

# Mainnet scripts (create-config-mainnet, launch-mainnet, claim-partner-fees-mainnet, ...).
# A private RPC URL (e.g. Helius) contains an API key: keep it only in scripts/.env.
MAINNET_RPC_URL=
# Priority fee for mainnet sends, micro-lamports per compute unit.
MAINNET_PRIORITY_MICROLAMPORTS=1000
# Jupiter API base (Pay with SOL quotes in the mainnet test scripts).
JUPITER_API_URL=https://lite-api.jup.ag

# Devnet faucet only: lets scripts send without --live.
# HATCH_LIVE=1
