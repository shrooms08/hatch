    "status-mainnet": "node --env-file-if-exists=.env --import tsx src/status-mainnet.ts",
    "claim-partner-fees-mainnet": "node --env-file-if-exists=.env --import tsx src/claim-partner-fees-mainnet.ts",
    "swap-nvdax-to-sol-mainnet": "node --env-file-if-exists=.env --import tsx src/swap-nvdax-to-sol-mainnet.ts",
