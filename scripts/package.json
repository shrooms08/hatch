    "cost-estimate-mainnet": "node --env-file-if-exists=.env --import tsx src/cost-estimate-mainnet.ts",
    "create-config-mainnet": "node --env-file-if-exists=.env --import tsx src/create-config-mainnet.ts",
    "launch-mainnet": "node --env-file-if-exists=.env --import tsx src/launch-mainnet.ts",
