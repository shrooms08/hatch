# Hatch web app base URL (AI endpoints, hatches API, /launch). Default http://localhost:3000.
WXT_HATCH_WEB_URL=http://localhost:3000
# devnet | mainnet-beta (default devnet). On devnet every stock maps to the mock NVDAx mint.
WXT_HATCH_NETWORK=devnet
# Optional: mock NVDAx mint for devnet. Defaults to scripts/state/devnet.json's mockStock.mint at build time.
WXT_DEVNET_STOCK_MINT=
