# ---- Network ----
# Which Solana cluster the app talks to: devnet | mainnet-beta (default devnet).
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# Server-side RPC used by API routes to read chain state and build unsigned transactions.
RPC_URL=https://api.devnet.solana.com
# Browser RPC used by the wallet to send transactions and by pages to read pool state.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# ---- Presets ----
# Server-side allowlist of DBC config keys for the SOL-quoted presets (JSON). AI_AGENT may reuse MEME's config.
POOL_CONFIGS={"MEME":"","AI_AGENT":""}
# Stocks Hatch can pair with on this network (JSON, keyed by ticker). A STOCK launch is only allowed for
# tickers listed here; anything else is "coming soon". quoteMint = the tokenized stock (xStock) mint.
STOCK_CONFIGS={"NVDA":{"config":"","quoteMint":"","symbol":"NVDAx","name":"NVIDIA"}}
# Comma-separated mints hidden from public lists (test tokens). Their token pages still work by link.
HIDDEN_MINTS=

# ---- Cloudflare R2 (token images + metadata JSON) ----
# R2 API token access key ID.
R2_ACCESS_KEY_ID=
# R2 API token secret.
R2_SECRET_ACCESS_KEY=
# Cloudflare account ID (used to build the R2 S3 endpoint).
R2_ACCOUNT_ID=
# R2 bucket name.
R2_BUCKET=
# Public base URL that serves the bucket (r2.dev URL or custom domain), no trailing slash.
R2_PUBLIC_URL=

# ---- Transactions ----
# Priority fee (micro-lamports per compute unit) added to every transaction the app builds.
NEXT_PUBLIC_PRIORITY_FEE_MICROLAMPORTS=100000

# ---- Feature flags ----
# They depend on undocumented Jupiter endpoints that only index mainnet, so keep false on devnet.

# ---- AI (Hatch browser buddy: /api/buddy/*) ----
# Anthropic API key, server-side only. Without it the buddy endpoints answer "AI not configured".
ANTHROPIC_API_KEY=
# Model for drafting tokens (default claude-sonnet-5-5).
ANTHROPIC_MODEL_DRAFT=claude-sonnet-5-5
# Fast model for the page-notice check (default claude-haiku-4-5-20251001).
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
