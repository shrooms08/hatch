{
  "name": "hatch-web",
  "version": "0.1.0",
  "private": true,
  "author": "Hatch",
  "scripts": {
    "clean": "rm -rf node_modules .next .turbo",
    "dev": "next dev --turbopack",
    "dev:mainnet": "NEXT_DIST_DIR=.next-mainnet node --env-file=.env.mainnet.local node_modules/next/dist/bin/next dev --turbopack -p ${PORT:-3000}",
    "build": "next build",
    "build:mainnet": "NEXT_DIST_DIR=.next-mainnet node --env-file=.env.mainnet.local node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:buddy": "node --env-file-if-exists=.env.local --import tsx scripts/test-buddy.mts",
    "brand-assets": "node --import tsx scripts/brand-assets.mts",
    "test:stats": "node --import tsx --test scripts/test-stats.mts",
    "test:security": "node --import tsx --test scripts/test-security.mts",
    "test": "node --import tsx --test scripts/test-stats.mts scripts/test-security.mts scripts/test-presets-v2.mts scripts/test-share.mts scripts/test-errors.mts scripts/test-polish.mts scripts/test-cache.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1100.0",
    "@coral-xyz/anchor": "^0.31.1",
    "@jup-ag/wallet-adapter": "^0.2.6",
    "@meteora-ag/cp-amm-sdk": "1.5.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.13",
    "@resvg/resvg-js": "^2.6.2",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-phantom": "^0.9.30",
    "@solana/wallet-adapter-solflare": "^0.6.34",
    "@solana/web3.js": "^1.99.0",
    "@tanstack/react-query": "^4.44.0",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "jotai": "^2.20.2",
    "next": "^15.5.24",
    "next-themes": "^0.4.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bn.js": "^5.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.24",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "rpc-websockets>uuid": "^11.1.0"
    }
  }
}
