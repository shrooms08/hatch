# Hatch web app on MAINNET (no secrets here). Copy to .env.mainnet.local and fill the secret values,
# then run `pnpm dev:mainnet`. Devnet stays the default for plain `pnpm dev` (.env.local).

NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# Server-side mainnet RPC (Helius). Secret: fill in .env.mainnet.local. Used by API routes and /api/rpc.
HATCH_SERVER_RPC_URL=
RPC_URL=
# The browser talks only to Hatch's own same-origin proxy; no provider key ships to the browser.
# Production: https://hatchfun.vercel.app/api/rpc. A path resolves against the page origin.
NEXT_PUBLIC_RPC_URL=/api/rpc

# Launch configs created on mainnet (docs/phase3.md). AI_AGENT reuses the MEME config.
POOL_CONFIGS={"MEME":"HjeeZN7aDtgfAoiVh8F17GeAKVAg4DFJsHx8Ap2GUfqv","AI_AGENT":"HjeeZN7aDtgfAoiVh8F17GeAKVAg4DFJsHx8Ap2GUfqv"}
# NVDAx (NVIDIA xStock) quote; config has the Meteora token badge mfacWnGh1Kn5ttHMMaNZhRZbCjvGrDQyDyZgqaR9vBM.
STOCK_CONFIGS={"NVDA":{"config":"HX9EjDXFjazM5gLyN2hUG5SRsH9BMorKi1EhVVw1BzJ6","quoteMint":"Xsc9qvGR1efVDFGLrVsmkzv3qi45LTBjeUKSPmx9qEh","symbol":"NVDAx","name":"NVIDIA"}}
# Mints hidden from public lists (none on production).
HIDDEN_MINTS=
# Test launches: listed with a "Test launch" badge. HGTEST (Hatch Genesis Test).
TEST_MINTS=Eekou3Ckcd2Hxk1MaeVepRafCH6SHU7sybNrifizUZfb

# Cloudflare R2 (secrets): token images + metadata.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PUBLIC_URL=

# AI (secret).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DRAFT=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# Small but real priority fee on mainnet (micro-lamports per CU).
NEXT_PUBLIC_PRIORITY_FEE_MICROLAMPORTS=50000
# Jupiter-indexer features (explore/charts/plugin) stay off; Hatch reads pools from chain.
NEXT_PUBLIC_ENABLE_JUPITER_DATA=false
