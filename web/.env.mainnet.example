# Hatch web app on MAINNET (no secrets here). Copy to .env.mainnet.local and fill the secret values,
# then run `pnpm dev:mainnet`. Devnet stays the default for plain `pnpm dev` (.env.local).

NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# Server-side mainnet RPC (Helius). Secret: fill in .env.mainnet.local. Used by API routes and /api/rpc.
HATCH_SERVER_RPC_URL=
RPC_URL=
# The browser talks only to Hatch's own same-origin proxy; no provider key ships to the browser.
# Production: https://hatchfun.vercel.app/api/rpc. A path resolves against the page origin.
NEXT_PUBLIC_RPC_URL=/api/rpc

# v2 launch configs (README "Presets v2"): every one has the Sniper shield (fee 50% -> 1% over 60 s).
POOL_CONFIGS={"MEME":"HoRw7tSgAXg2XUUDckRG4GWtC3DX21RC4RKB5PNittym","AI_AGENT":"B9rKSC6vQHrvvzjn4yakiU4euW54SYS1e58QVh8F26CB"}
# xStock quotes (NVDAx, TSLAx), each with its Meteora token badge.
STOCK_CONFIGS={"NVDA":{"config":"BMHNjCP16u6Dch1mW6qe1zfHEJJpRkmrXi5aZw1ogL1y","quoteMint":"Xsc9qvGR1efVDFGLrVsmkzv3qi45LTBjeUKSPmx9qEh","symbol":"NVDAx","name":"NVIDIA"},"TSLA":{"config":"HJKEzsNZGHSgSzfHdFeLfAKWcefYYo4Sd5DNiaDvfWYP","quoteMint":"XsDoVfqeBukxuZHWhdvWHBhgEHjGNst4MLodqsJHzoB","symbol":"TSLAx","name":"Tesla"}}
# v1 configs: no new launches, but their pools (HGTEST) keep their preset, stats and trading.
LEGACY_CONFIGS=[{"config":"HX9EjDXFjazM5gLyN2hUG5SRsH9BMorKi1EhVVw1BzJ6","preset":"STOCK","stock":"NVDA"},{"config":"HjeeZN7aDtgfAoiVh8F17GeAKVAg4DFJsHx8Ap2GUfqv","preset":"MEME"}]
# Mints hidden from public lists (none on production).
HIDDEN_MINTS=
# Test launches: listed with a "Test launch" badge. HGTEST (Hatch Genesis Test).
TEST_MINTS=Eekou3Ckcd2Hxk1MaeVepRafCH6SHU7sybNrifizUZfb

# Cloudflare R2 (secrets): token images + metadata.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PUBLIC_URL=

# AI (secret).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DRAFT=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# Small but real priority fee on mainnet (micro-lamports per CU).
NEXT_PUBLIC_PRIORITY_FEE_MICROLAMPORTS=50000
